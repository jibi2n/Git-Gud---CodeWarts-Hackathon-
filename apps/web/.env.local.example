# Copy to .env.local. Leave ML_SERVICE_URL UNSET to run in demo mode
# (fake fixtures from lib/demo-fixtures.ts). Set it once Role 1 & 4 / Role 2
# have the FastAPI service exposing /transcribe, /extract, /score.

# ML_SERVICE_URL=http://localhost:8000
# ML_SERVICE_API_KEY=

# Frontend Supabase (Role 3 fills these in once a Supabase project exists)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase
# SUPABASE_SERVICE_ROLE_KEY=
